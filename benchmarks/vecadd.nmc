// Vector addition: the simplest streaming kernel -> offload, elementwise.
array float A[16384];
array float B[16384];
array float C[16384];

kernel vecadd() {
    for (i = 0; i < 16384; i += 1) {
        C[i] = A[i] + B[i];
    }
}

host main() {
    for (i = 0; i < 16384; i += 1) {
        A[i] = i * 0.5;
        B[i] = i * 0.25;
    }
    call vecadd();
    print C[0];
    print C[100];
    print C[16383];
}
