// 5-point 2-D stencil.  Rows are partitioned; one halo row above and below.
array float A[128, 128];
array float B[128, 128];

kernel stencil2d() {
    for (i = 1; i < 127; i += 1) {
        for (j = 1; j < 127; j += 1) {
            B[i, j] = (A[i - 1, j] + A[i + 1, j] + A[i, j - 1] + A[i, j + 1]) * 0.25;
        }
    }
}

host main() {
    for (i = 0; i < 128; i += 1) {
        for (j = 0; j < 128; j += 1) {
            A[i, j] = (i * 3 + j) * 0.125;
        }
    }
    call stencil2d();
    print B[1, 1];
    print B[64, 64];
}
