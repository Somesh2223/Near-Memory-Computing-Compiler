// Matrix transpose: B[j,i] = A[i,j].  No arithmetic and perfectly parallel, but
// the written element is owned by a different unit than the iteration that
// writes it, so partitioning needs an all-to-all shuffle -> REJECT.
array float A[128, 128];
array float B[128, 128];

kernel transpose() {
    for (i = 0; i < 128; i += 1) {
        for (j = 0; j < 128; j += 1) {
            B[j, i] = A[i, j];
        }
    }
}

host main() {
    for (i = 0; i < 128; i += 1) {
        for (j = 0; j < 128; j += 1) {
            A[i, j] = (i * 128 + j) * 0.5;
        }
    }
    call transpose();
    print B[1, 0];
    print B[127, 5];
}
