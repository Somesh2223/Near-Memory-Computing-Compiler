// SAXPY: C = alpha*A + B.  Streaming, elementwise, no reuse -> offload.
array float A[16384];
array float B[16384];
array float C[16384];
scalar float alpha;

kernel saxpy() {
    for (i = 0; i < 16384; i += 1) {
        C[i] = alpha * A[i] + B[i];
    }
}

host main() {
    alpha = 2.0;
    for (i = 0; i < 16384; i += 1) {
        A[i] = i * 0.5;
        B[i] = i * 0.25;
    }
    call saxpy();
    if (alpha > 0.0) {
        print C[0];
    } else {
        print C[1];
    }
    print C[16383];
}
