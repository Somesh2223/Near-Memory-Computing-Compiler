// Column-major traversal: the inner loop walks down a column (stride 512 B).
// Loop interchange makes the inner loop stride-1 and puts the row loop outermost,
// which is what owner-computes partitioning needs.
array float A[128, 128];
array float B[128, 128];

kernel colmajor() {
    for (j = 0; j < 128; j += 1) {
        for (i = 0; i < 128; i += 1) {
            B[i, j] = A[i, j] * 2.0;
        }
    }
}

host main() {
    for (i = 0; i < 128; i += 1) {
        for (j = 0; j < 128; j += 1) {
            A[i, j] = (i + j * 2) * 0.5;
        }
    }
    call colmajor();
    print B[3, 4];
    print B[127, 127];
}
