// YACC exercise 4 (for-loop syntax), VALID forms.   Run:  --dump ast
// Our bison grammar (src/parser.y):
//   forstmt : FOR '(' IDENT '=' expr ';' IDENT relop expr ';' IDENT PLUSEQ expr ')'
//             '{' stmt_list '}'
// The semantic pass then checks the rules a grammar cannot: the three slots name
// the same variable, the bounds are integer constants and the step is positive.
array float A[64];
array float B[8, 8];

kernel loops() {
    for (i = 0; i < 64; i += 1) {
        A[i] = A[i] + 1.0;
    }
    for (i = 0; i <= 62; i += 2) {
        A[i] = 0.0;
    }
    for (i = 0; i < 8; i += 1) {
        for (j = 0; j < 8; j += 1) {
            B[i, j] = A[i] * 2.0;
        }
    }
}

host main() {
    call loops();
    print B[7, 7];
}
