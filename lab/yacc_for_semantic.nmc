// YACC exercise 4, part 2: for loops that PARSE but break a rule the grammar
// cannot express.   Run:  --check
//   the header names two different variables (k and m)
//   the upper bound is a variable, not a constant
//   the loop index is changed inside the body
array float A[64];
scalar int n;

kernel loops() {
    for (k = 0; k < 64; m += 1) {
        A[k] = 0.0;
    }
    for (i = 0; i < n; i += 1) {
        A[i] = 1.0;
    }
    for (i = 0; i < 64; i += 1) {
        i = 5;
    }
}

host main() {
    n = 10;
    call loops();
}
