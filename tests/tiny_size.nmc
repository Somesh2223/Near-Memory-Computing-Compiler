// Size check: a perfectly offloadable nest (elementwise, parallel, AI far below
// the machine balance) that is simply too small.  The host finishes it in a few
// thousand cycles, less than the 80000-cycle launch overhead alone, so the
// compiler keeps it on the host.  Compare with benchmarks/saxpy.nmc (16384
// elements), which is offloaded.
array float A[256];
array float B[256];

kernel tiny() {
    for (i = 0; i < 256; i += 1) {
        B[i] = A[i] * 2.0 + 1.0;
    }
}

host main() {
    for (i = 0; i < 256; i += 1) {
        A[i] = i * 0.5;
    }
    call tiny();
    print B[7];
}
